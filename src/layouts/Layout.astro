---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Athul Thomas - Developer Portfolio" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#12131a" />
    <link rel="icon" type="image/png" href="/command-line.png" />
    <title>{title}</title>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Athul Thomas",
        "url": "https://athulthomasatz.github.io",
        "sameAs": [
          "https://github.com/athulthomasatz",
          "https://www.linkedin.com/in/athulthomasatz",
          "https://www.datacamp.com/portfolio/athulthomasatz",
          "https://codeforces.com/profile/athulthomasatz"
        ],
        "jobTitle": "Full-Stack Developer",
        "knowsAbout": ["React", "Node.js", "JavaScript", "MongoDB", "Express", "Python", "HTML", "CSS"]
      }
    </script>
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
