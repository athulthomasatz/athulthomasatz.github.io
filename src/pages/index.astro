---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.jsx';
import MobileDrawer from '../components/MobileDrawer.jsx';
import DashboardGrid from '../components/DashboardGrid.jsx';
import '../styles/global.css';
---

<Layout title="Athul Thomas — Developer">
  <div class="flex h-screen overflow-hidden">
    <Sidebar client:load />
    <MobileDrawer client:load />

    <!-- Main Stage: fills remaining viewport -->
    <main class="main-content flex-1 h-screen overflow-hidden flex flex-col">
      <!-- Compact 40px header bar -->
      <header class="
        flex items-center justify-between
        shrink-0
        h-10
        px-3
        border-b border-white/5
      ">
        <!-- Left: Brand -->
        <span class="text-white font-bold text-xs tracking-widest uppercase font-mono hidden md:block">
          SYSTEM_ROOT
        </span>

        <!-- Center: Status pills -->
        <div class="hidden md:flex items-center gap-3 text-[11px] font-mono text-text-secondary tracking-wide">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse" />
            STATUS:ONLINE
          </span>
          <span class="text-white/10">·</span>
          <span>CPU:24%</span>
          <span class="text-white/10">·</span>
          <span>RAM:1.2GB</span>
        </div>

        <!-- Right: Actions -->
        <div class="flex items-center gap-2">
          <a
            href="/v1/index.html"
            class="
              inline-flex items-center gap-1.5
              px-2.5 py-1 rounded-md
              bg-white/5 border border-white/10
              text-[11px] font-mono text-white/60
              hover:bg-white/10 hover:border-white/20 hover:text-white
              transition-all duration-200
            "
          >
            View v1
          </a>
        </div>
      </header>

      <!-- Dashboard Grid -->
      <div class="flex-1 min-h-0 p-3">
        <DashboardGrid client:load />
      </div>
    </main>
  </div>
</Layout>
