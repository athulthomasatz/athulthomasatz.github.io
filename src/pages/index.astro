---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.jsx';
import MobileDrawer from '../components/MobileDrawer.jsx';
import '../styles/global.css';
---

<Layout title="Athul Thomas — Developer">
  <Sidebar client:load />
  <MobileDrawer client:load />

  <main class="main-content min-h-screen">
    <section
      id="home"
      class="min-h-screen flex items-center justify-center px-6 md:px-12"
    >
      <div class="text-center space-y-6">
        <h1 class="text-5xl md:text-7xl font-mono font-bold tracking-tight">
          Athul Thomas
        </h1>
        <p class="text-lg md:text-xl text-[#a1a1aa] max-w-xl mx-auto">
          Full-Stack Developer building modern web experiences.
        </p>
        <p class="text-sm text-[#a1a1aa]/70 font-mono">
          New portfolio coming soon.
        </p>
        <a
          href="/v1/index.html"
          class="inline-block mt-8 px-6 py-3 bg-[#00f0ff] text-[#12131a] font-mono font-semibold rounded-lg hover:brightness-110 transition-all"
        >
          View v1 Portfolio (2024 – 2026)
        </a>
      </div>
    </section>

    <section
      id="about"
      class="min-h-screen flex items-center justify-center px-6 md:px-12 border-t border-white/5"
    >
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <h2 class="text-3xl md:text-5xl font-bold">About</h2>
        <p class="text-[#a1a1aa] text-lg">Content coming soon.</p>
      </div>
    </section>

    <section
      id="projects"
      class="min-h-screen flex items-center justify-center px-6 md:px-12 border-t border-white/5"
    >
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <h2 class="text-3xl md:text-5xl font-bold">Projects</h2>
        <p class="text-[#a1a1aa] text-lg">Content coming soon.</p>
      </div>
    </section>

    <section
      id="certificates"
      class="min-h-screen flex items-center justify-center px-6 md:px-12 border-t border-white/5"
    >
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <h2 class="text-3xl md:text-5xl font-bold">Certificates</h2>
        <p class="text-[#a1a1aa] text-lg">Content coming soon.</p>
      </div>
    </section>

    <section
      id="experience"
      class="min-h-screen flex items-center justify-center px-6 md:px-12 border-t border-white/5"
    >
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <h2 class="text-3xl md:text-5xl font-bold">Experience</h2>
        <p class="text-[#a1a1aa] text-lg">Content coming soon.</p>
      </div>
    </section>

    <section
      id="contact"
      class="min-h-screen flex items-center justify-center px-6 md:px-12 border-t border-white/5"
    >
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <h2 class="text-3xl md:text-5xl font-bold">Contact</h2>
        <p class="text-[#a1a1aa] text-lg">Content coming soon.</p>
      </div>
    </section>
  </main>
</Layout>
