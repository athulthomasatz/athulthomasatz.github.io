---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Athul Thomas — Developer">
  <main class="min-h-screen flex items-center justify-center px-6">
    <div class="text-center space-y-6">
      <h1 class="text-5xl md:text-7xl font-mono font-bold tracking-tight">
        Athul Thomas
      </h1>
      <p class="text-lg md:text-xl text-neutral-400 max-w-xl mx-auto">
        Full-Stack Developer building modern web experiences.
      </p>
      <p class="text-sm text-neutral-500 font-mono">
        New portfolio coming soon.
      </p>
      <a
        href="/v1/index.html"
        class="inline-block mt-8 px-6 py-3 bg-neutral-100 text-neutral-950 font-mono font-medium rounded-lg hover:bg-neutral-200 transition-colors"
      >
        View v1 Portfolio (2024 – 2026)
      </a>
    </div>
  </main>
</Layout>
