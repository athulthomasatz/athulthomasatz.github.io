---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.jsx';
import MobileDrawer from '../components/MobileDrawer.jsx';
import DashboardGrid from '../components/DashboardGrid.jsx';
import '../styles/global.css';
---

<Layout title="Athul Thomas — Developer">
  <div class="flex min-h-screen">
    <Sidebar client:load />
    <MobileDrawer client:load />

    <main class="main-content flex-1 min-h-screen p-4 md:p-6 lg:p-8 flex flex-col">
      <!-- SYSTEM_ROOT style header -->
      <header class="
        flex items-center justify-between
        mb-6 lg:mb-8
        pl-12 md:pl-0
        py-3 px-4 md:px-0
        border-b border-white/5
      ">
        <!-- Left: Brand -->
        <div class="flex items-center gap-4">
          <span class="text-white font-bold text-sm tracking-widest uppercase font-mono hidden md:block">
            Athul Thomas
          </span>
        </div>

        <!-- Center: Informative status line -->
        <div class="hidden md:flex items-center gap-4 text-xs font-mono text-text-secondary tracking-wide">
          <span class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse" />
            AVAILABLE
          </span>
          <span class="text-white/10">·</span>
          <span>EXP: 3+ YEARS</span>
          <span class="text-white/10">·</span>
          <span>LOC: INDIA</span>
        </div>

        <!-- Right: Actions -->
        <div class="flex items-center gap-3">
          <a
            href="/v1/index.html"
            class="
              inline-flex items-center gap-2
              px-3 py-1.5 rounded-md
              bg-white/5 border border-white/10
              text-xs font-mono text-white/60
              hover:bg-white/10 hover:border-white/20 hover:text-white
              transition-all duration-200
            "
          >
            View v1
          </a>
        </div>
      </header>

      <!-- Dashboard Grid -->
      <div class="flex-1 flex items-start">
        <DashboardGrid client:load />
      </div>
    </main>
  </div>
</Layout>
