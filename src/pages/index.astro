---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.jsx';
import MobileDrawer from '../components/MobileDrawer.jsx';
import DashboardGrid from '../components/DashboardGrid.jsx';
import '../styles/global.css';
---

<Layout title="Athul Thomas — Developer">
  <div class="flex min-h-screen">
    <Sidebar client:load />
    <MobileDrawer client:load />

    <main class="main-content flex-1 min-h-screen p-4 md:p-6 lg:p-8 flex flex-col">
      <!-- Top bar / Header area -->
      <header class="flex items-center justify-between mb-6 lg:mb-8 pl-12 md:pl-0">
        <div>
          <h1 class="text-xl lg:text-2xl font-bold tracking-tight text-white">
            Dashboard
          </h1>
          <p class="text-sm text-text-secondary mt-0.5" style="color: #a1a1aa;">
            Navigate with arrow keys or click to select
          </p>
        </div>
        <a
          href="/v1/index.html"
          class="
            hidden md:inline-flex items-center gap-2
            px-4 py-2 rounded-lg
            bg-white/5 border border-white/10
            text-sm font-mono text-white/80
            hover:bg-white/10 hover:border-white/20
            transition-all duration-200
          "
        >
          View v1 Portfolio
        </a>
      </header>

      <!-- Dashboard Grid -->
      <div class="flex-1 flex items-start">
        <DashboardGrid client:load />
      </div>
    </main>
  </div>
</Layout>
